FROM node:22-alpine

ENV COREPACK_HOME=/usr/local/share/corepack
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV PNPM_HOME=/home/workspace/.local/share/pnpm
ENV PNPM_STORE_DIR=/home/workspace/.pnpm-store
ENV PATH="$PNPM_HOME:$PATH"

RUN apk add --no-cache git openssl ca-certificates su-exec \
	&& mkdir -p "$COREPACK_HOME" \
	&& corepack enable \
	&& corepack prepare pnpm@10.33.2 --activate \
	&& chmod -R a+rX "$COREPACK_HOME"

WORKDIR /workspace

COPY docker/workspace-entrypoint.sh /usr/local/bin/workspace-entrypoint.sh
RUN chmod +x /usr/local/bin/workspace-entrypoint.sh

ENTRYPOINT ["workspace-entrypoint.sh"]
CMD ["sh"]