# Local Docker Compose example values.
# Copy this file to .env for local Docker Compose only.
# Do not use these placeholder values for production.

POSTGRES_DB=insightful_phish_dev
POSTGRES_USER=insightful_phish
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_PORT=5432

BACKEND_PORT=4000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173

# Browser-facing URL used when building the frontend Docker image.
VITE_API_BASE_URL=http://localhost:4000

# Only needed when running the Demo 1 seed locally.
DEMO_SEED_PASSWORD=change-me-local-demo-password