# Local Docker Compose example values.
# Copy this file to .env for local Docker Compose only.
# Do not use these placeholder values for production.

POSTGRES_DB=insightful_phish_dev
POSTGRES_USER=insightful_phish
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_PORT=5432

# Linux users should probably set these to their own UID and GID to avoid file permission issues when running the workspace container.
# macOS and Windows Docker Desktop users can usually leave this alone
LOCAL_UID=1000
LOCAL_GID=1000

BACKEND_PORT=4000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_ADDRESS=noreply@insightful-phish.local
SMTP_FROM_NAME=Insightful Phish
SMTP_USER=
SMTP_PASSWORD=

# Browser-facing URL used when building the frontend Docker image.
VITE_API_BASE_URL=http://localhost:4000

# Only needed when running the Demo 1 seed locally.
DEMO_SEED_PASSWORD=change-me-local-demo-password

# Optional first platform super-admin bootstrap for local development.
AUTH_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_SUPER_ADMIN_NAME=Platform Admin
