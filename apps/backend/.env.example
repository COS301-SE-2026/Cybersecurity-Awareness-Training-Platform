NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://insightful_phish:change-me-local-postgres-password@localhost:5432/insightful_phish_dev"
TEST_DATABASE_URL="postgresql://insightful_phish:change-me-local-postgres-password@localhost:5432/insightful_phish_test"

# If the backend runs inside Docker Compose, the database host is the Compose service name:
# DATABASE_URL="postgresql://insightful_phish:change-me-local-postgres-password@postgres:5432/insightful_phish_dev"


FRONTEND_ORIGIN="http://localhost:5173"

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_ADDRESS=noreply@insightful-phish.local
SMTP_FROM_NAME=Insightful Phish
SUPPORT_EMAIL_ADDRESS=support@insightfulphish.co.za
SMTP_USER=
SMTP_PASSWORD=

# Do not use this secret token in production. Change it to a secure random string before deploying to production.
AUTH_TOKEN_SECRET="this-is-a-demo-auth-secret-token-change-before-production"
AUTH_TOKEN_EXPIRES_IN_SECONDS=28800

AUTH_COOKIE_SECURE=false #note that https deployments must use true. Local dev can use false

AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20


# Only needed when running the Demo 1 seed locally.
# DEMO_SEED_PASSWORD="change-me-local-demo-password"


# Optional first platform super-admin bootstrap.
# AUTH_BOOTSTRAP_SUPER_ADMIN_EMAIL="admin@example.com"
# AUTH_BOOTSTRAP_SUPER_ADMIN_PASSWORD=""
# AUTH_BOOTSTRAP_SUPER_ADMIN_NAME="Platform Admin"


EMAIL_DISPATCHER_ENABLED=true
EMAIL_DISPATCHER_POLL_INTERVAL_MS=1000
EMAIL_DISPATCHER_BATCH_SIZE=10
EMAIL_DISPATCHER_LEASE_SECONDS=30
EMAIL_DISPATCHER_MAX_ATTEMPTS=4
EMAIL_DISPATCHER_BACKOFF_SECONDS=15,30,60
EMAIL_DISPATCHER_RETRY_DEADLINE_SECONDS=120
