generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  IP_ADMIN
  ORGANISATION_ADMIN
  ORGANISATION_TRAINEE
  GENERAL_TRAINEE
}

enum AuthStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_INVITE_SETUP
  ACTIVE
  DISABLED
}

enum TraineeStatus {
  ACTIVE
  INACTIVE
}

enum OrganisationUserStatus {
  ACTIVE
  INACTIVE
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum PlatformAdminRole {
  SUPER_ADMIN
  NORMAL_ADMIN
}

enum AuthSessionRevokedReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_RESET
  PASSWORD_CHANGE
  EMAIL_CHANGE
  ADMIN_DISABLED
  ORGANISATION_SUSPENDED
  TOKEN_REUSE_DETECTED
  EXPIRED
  OTHER
}

enum RefreshTokenRevokedReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_RESET
  PASSWORD_CHANGE
  EMAIL_CHANGE
  TOKEN_REUSE_DETECTED
  EXPIRED
  OTHER
}

enum ActionTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE_VERIFICATION
  INITIAL_ORGANISATION_ADMIN_SETUP
  ORGANISATION_TRAINEE_INVITE
  ORGANISATION_ADMIN_PROMOTION
  PLATFORM_ADMIN_INVITE
  PLATFORM_ADMIN_UPGRADE_CONFIRMATION
}

enum EmailDeliveryType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PASSWORD_CHANGED
  EMAIL_CHANGE_CONFIRMATION
  EMAIL_CHANGE_WARNING
  ORGANISATION_REQUEST_RECEIVED
  ORGANISATION_REQUEST_APPROVED
  ORGANISATION_REQUEST_REJECTED
  INITIAL_ORGANISATION_ADMIN_SETUP
  ORGANISATION_TRAINEE_INVITE
  ORGANISATION_ADMIN_PROMOTION_INVITE
  PLATFORM_ADMIN_INVITE
  PLATFORM_ADMIN_UPGRADE_CONFIRMATION
  ROLE_CHANGED_NOTIFICATION
}

enum EmailRelatedEntityType {
  USER
  INVITATION
  ACTIONTOKEN
  ORGANISATION_REGISTRATION_REQUEST
  EMAIL_CHANGE_REQUEST
  ORGANISATION
  OTHER
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum GeneralTraineeAccessSource {
  SELF_SIGNUP
  INVITE
  SEED
  ADMIN_CREATED
}

enum OrganisationStatus {
  PENDING_ONBOARDING
  ACTIVE
  INACTIVE
  SUSPENDED
  DISABLED
  ARCHIVED
}

enum OrganisationRegistrationRequestStatus {
  PENDING_REVIEW
  CONTACTED
  APPROVED
  REJECTED
  CANCELLED
}

enum InvitationPurpose {
  INITIAL_ORGANISATION_ADMIN_SETUP
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrganisationContextType {
  LOGO
  BRAND_GUIDELINES
  SECURITY_POLICY
  STAFF_STRUCTURE
  INTERNAL_TERMINOLOGY
  APPROVED_DOMAINS
  EMAIL_SIGNATURE_FORMAT
  OTHER
}

enum OrganisationContextProcessingStatus {
  UPLOADED
  PROCESSING
  READY
  NEEDS_REVIEW
  ARCHIVED
}

enum CampaignType {
  PREMADE_GENERAL
  ORGANISATION_CUSTOM
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ADAPTIVE
}

enum CampaignItemType {
  COMPONENT
  GROUP
}

enum CampaignComponentType {
  TRAINING_DOCUMENT
  QUIZ
  SIMULATED_INBOX
}

enum CampaignGroupType {
  SECTION
  MODULE
  REVISION_SET
  ASSESSMENT_SET
  SIMULATION_SET
}

enum CompletionRule {
  COMPLETE_ALL
  COMPLETE_ANY
  COMPLETE_REQUIRED_ONLY
}

enum CampaignItemAvailabilityStatus {
  AVAILABLE
  LOCKED
  UNAVAILABLE
  ARCHIVED
}

enum AssignmentStatus {
  AVAILABLE
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum CampaignAccessType {
  ASSIGNED
  SELF_SELECTED
}

enum CampaignPrerequisiteRequirementType {
  COMPLETION_REQUIRED
}

enum TrainingContentType {
  PDF
  MARKDOWN
  HTML
  URL
  INTERACTIVE
}

enum TrainingDocumentStatus {
  DRAFT
  AVAILABLE
  UNAVAILABLE
  ARCHIVED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum SimulationType {
  SIMULATED_INBOX
}

enum SafetyStatus {
  DRAFT
  APPROVED
  BLOCKED
}

enum InboxStatus {
  ACTIVE
  ARCHIVED
}

enum EmailClassification {
  SAFE
  SUSPICIOUS
  PHISHING
}

enum EmailRedFlagType {
  SENDER
  LINK
  LANGUAGE
  ATTACHMENT
  REQUEST
  DOMAIN
  OTHER
}

enum RedFlagSeverity {
  LOW
  MEDIUM
  HIGH
}

enum InteractionEventType {
  CAMPAIGN_STARTED
  CAMPAIGN_ITEM_STARTED
  CAMPAIGN_ITEM_COMPLETED
  TRAINING_VIEWED
  TRAINING_COMPLETED
  QUIZ_STARTED
  QUIZ_ANSWER_SUBMITTED
  QUIZ_COMPLETED
  SIMULATED_EMAIL_OPENED
  SIMULATED_EMAIL_LINK_CLICKED
  SIMULATED_EMAIL_CLASSIFIED
  CREDENTIAL_SUBMISSION_ATTEMPTED
}

enum InteractionTargetType {
  CAMPAIGN
  CAMPAIGN_ITEM
  CAMPAIGN_COMPONENT
  TRAINING_DOCUMENT
  QUIZ
  QUIZ_ATTEMPT
  QUIZ_QUESTION
  SIMULATED_EMAIL
  EMAIL_CLASSIFICATION_RESPONSE
}

enum AuditActorType {
  IP_ADMIN
  ORGANISATION_ADMIN
  ORGANISATION_TRAINEE
  GENERAL_TRAINEE
  SYSTEM
}

enum AuditTargetType {
  USER
  ORGANISATION
  ORGANISATION_REGISTRATION_REQUEST
  INVITATION
  ORGANISATION_ADMIN_PERMISSION
  ORGANISATION_SECURITY_SETTINGS
  PLATFORM_ADMIN_ROLE
  AUTH_SESSION
  CAMPAIGN
  OTHER
  TOKEN
  ACTION_TOKEN
  REFRESH_TOKEN
}

enum AuditActionType {
  CREATED
  UPDATED
  DISABLED
  ENABLED
  APPROVED
  REJECTED
  CONTACTED
  INVITED
  RESENT
  REVOKED
  ACCEPTED
  COMPLETED
  PROMOTED
  DEMOTED
  PERMISSIONS_CHANGED
  SETTINGS_CHANGED
  SUSPENDED
  REACTIVATED
  LOGIN
  LOGOUT
  TOKEN_REUSE_DETECTED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model HealthCheck {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
}

model User {
  id                           String                    @id @default(uuid())
  firstName                    String
  lastName                     String
  email                        String                    @unique
  passwordHash                 String
  userType                     UserType
  authStatus                   AuthStatus                @default(ACTIVE)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  traineeProfile               TraineeProfile?
  organisationAdminProfile     OrganisationAdminProfile?
  ipAdminProfile               IpAdminProfile?
  uploadedOrganisationContexts OrganisationContext[]     @relation("OrganisationContextUploadedBy")
  createdCampaigns             Campaign[]                @relation("CampaignCreatedBy")
  assignedCampaignAssignments  CampaignAssignment[]      @relation("CampaignAssignmentAssignedBy")
  createdTrainingDocuments     TrainingDocument[]        @relation("TrainingDocumentCreatedBy")
  createdQuizzes               Quiz[]                    @relation("QuizCreatedBy")
  createdSimulations           Simulation[]              @relation("SimulationCreatedBy")
  emailVerifiedAt              DateTime?
  lastLoginAt                  DateTime?
  disabledAt                   DateTime?
  disabledReason               String?
  authSessions                 AuthSession[]
  actionTokens                 ActionToken[]
  emailDeliveryLogs            EmailDeliveryLog[]
  auditLogEntries              AuditLogEntry[]           @relation("AuditLogEntryActor")
}

model TraineeProfile {
  id                           String                        @id @default(uuid())
  userId                       String                        @unique
  traineeStatus                TraineeStatus                 @default(ACTIVE)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  generalTraineeProfile        GeneralTraineeProfile?
  organisationTraineeProfile   OrganisationTraineeProfile?
  campaignAssignments          CampaignAssignment[]
  quizAttempts                 QuizAttempt[]
  emailClassificationResponses EmailClassificationResponse[]
  interactionEvents            InteractionEvent[]

  @@index([traineeStatus])
}

model GeneralTraineeProfile {
  id               String                     @id @default(uuid())
  traineeProfileId String                     @unique
  accessSource     GeneralTraineeAccessSource @default(SELF_SIGNUP)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  traineeProfile   TraineeProfile             @relation(fields: [traineeProfileId], references: [id], onDelete: Cascade)
}

model OrganisationTraineeProfile {
  id                     String                 @id @default(uuid())
  traineeProfileId       String                 @unique
  organisationId         String
  employeeLabel          String?
  joinedAt               DateTime               @default(now())
  organisationUserStatus OrganisationUserStatus @default(ACTIVE)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  traineeProfile         TraineeProfile         @relation(fields: [traineeProfileId], references: [id], onDelete: Cascade)
  organisation           Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([organisationUserStatus])
}

model OrganisationAdminProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  organisationId String
  adminStatus    AdminStatus  @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([adminStatus])
}

model IpAdminProfile {
  id                                        String                            @id @default(uuid())
  userId                                    String                            @unique
  adminStatus                               AdminStatus                       @default(ACTIVE)
  platformAdminRole                         PlatformAdminRole                 @default(NORMAL_ADMIN)
  joinedAt                                  DateTime                          @default(now())
  revokedAt                                 DateTime?
  revokedReason                             String?
  createdAt                                 DateTime                          @default(now())
  updatedAt                                 DateTime                          @updatedAt
  user                                      User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactedOrganisationRegistrationRequests OrganisationRegistrationRequest[] @relation("OrganisationRegistrationRequestContactedBy")
  approvedOrganisationRegistrationRequests  OrganisationRegistrationRequest[] @relation("OrganisationRegistrationRequestApprovedBy")
  rejectedOrganisationRegistrationRequests  OrganisationRegistrationRequest[] @relation("OrganisationRegistrationRequestRejectedBy")

  @@index([adminStatus])
  @@index([platformAdminRole])
  @@index([revokedAt])
}

model AuthSession {
  id                 String                    @id @default(uuid())
  userId             String
  rememberMe         Boolean                   @default(false)
  createdAt          DateTime                  @default(now())
  lastActiveAt       DateTime                  @default(now())
  expiresAt          DateTime
  idleTimeoutMinutes Int?
  revokedAt          DateTime?
  revokedReason      AuthSessionRevokedReason?
  userAgent          String?
  ipAddress          String?
  deviceSummary      String?
  locationSummary    String?
  updatedAt          DateTime                  @updatedAt
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens      RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([lastActiveAt])
  @@index([revokedAt])
}

model RefreshToken {
  id                String                     @id @default(uuid())
  authSessionId     String
  tokenHash         String                     @unique
  issuedAt          DateTime                   @default(now())
  expiresAt         DateTime
  usedAt            DateTime?
  revokedAt         DateTime?
  revokedReason     RefreshTokenRevokedReason?
  replacedByTokenId String?                    @unique
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  authSession       AuthSession                @relation(fields: [authSessionId], references: [id], onDelete: Cascade)
  replacedByToken   RefreshToken?              @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacedTokens    RefreshToken[]             @relation("RefreshTokenReplacement")

  @@index([authSessionId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([revokedAt])
}

model ActionToken {
  id                                String                           @id @default(uuid())
  tokenHash                         String                           @unique
  purpose                           ActionTokenPurpose
  userId                            String?
  invitationId                      String?
  emailChangeRequestId              String?
  organisationRegistrationRequestId String?
  targetEmail                       String?
  expiresAt                         DateTime
  usedAt                            DateTime?
  revokedAt                         DateTime?
  revokedReason                     String?
  createdAt                         DateTime                         @default(now())
  updatedAt                         DateTime                         @updatedAt
  user                              User?                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDeliveryLogs                 EmailDeliveryLog[]
  invitation                        Invitation?                      @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  organisationRegistrationRequest   OrganisationRegistrationRequest? @relation(fields: [organisationRegistrationRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([purpose])
  @@index([invitationId])
  @@index([emailChangeRequestId])
  @@index([organisationRegistrationRequestId])
  @@index([targetEmail])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([revokedAt])
}

model EmailDeliveryLog {
  id                                String                           @id @default(uuid())
  recipientEmail                    String
  emailType                         EmailDeliveryType
  /// Typed foreign keys are authoritative when a typed relation exists.
  /// Fallback related-entity fields are only for entities without a typed FK, legacy references, or OTHER cases.
  fallbackRelatedEntityType         EmailRelatedEntityType?          @map("relatedEntityType")
  fallbackRelatedEntityId           String?                          @map("relatedEntityId")
  userId                            String?
  actionTokenId                     String?
  organisationId                    String?
  organisationRegistrationRequestId String?
  invitationId                      String?
  deliveryStatus                    EmailDeliveryStatus              @default(PENDING)
  providerMessageId                 String?
  sentAt                            DateTime?
  failedAt                          DateTime?
  failureReason                     String?
  createdAt                         DateTime                         @default(now())
  updatedAt                         DateTime                         @updatedAt
  user                              User?                            @relation(fields: [userId], references: [id], onDelete: SetNull)
  actionToken                       ActionToken?                     @relation(fields: [actionTokenId], references: [id], onDelete: SetNull)
  organisation                      Organisation?                    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  organisationRegistrationRequest   OrganisationRegistrationRequest? @relation(fields: [organisationRegistrationRequestId], references: [id], onDelete: SetNull)
  invitation                        Invitation?                      @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([recipientEmail])
  @@index([emailType])
  @@index([fallbackRelatedEntityType, fallbackRelatedEntityId], map: "EmailDeliveryLog_relatedEntityType_relatedEntityId_idx")
  @@index([userId])
  @@index([actionTokenId])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@index([organisationId])
  @@index([organisationRegistrationRequestId])
  @@index([invitationId])
}

model Organisation {
  id                   String                            @id @default(uuid())
  name                 String                            @unique
  status               OrganisationStatus                @default(ACTIVE)
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  traineeProfiles      OrganisationTraineeProfile[]
  adminProfiles        OrganisationAdminProfile[]
  contexts             OrganisationContext[]
  campaigns            Campaign[]
  registrationRequests OrganisationRegistrationRequest[]
  invitations          Invitation[]
  emailDeliveryLogs    EmailDeliveryLog[]
  auditLogEntries      AuditLogEntry[]
}

model OrganisationRegistrationRequest {
  id                        String                                @id @default(uuid())
  submittedOrganisationName String
  submittedWebsite          String?
  submittedOrganisationDescription String?
  submittedOrganisationSize        Int?
  submittedPrimaryDomain    String?
  representativeFirstName   String
  representativeLastName    String
  representativeEmail       String
  representativePhone       String?
  status                    OrganisationRegistrationRequestStatus @default(PENDING_REVIEW)
  contactedByIpAdminId      String?
  approvedByIpAdminId       String?
  rejectedByIpAdminId       String?
  approvedOrganisationId    String?
  contactedAt               DateTime?
  approvedAt                DateTime?
  rejectedAt                DateTime?
  rejectionReason           String?
  createdAt                 DateTime                              @default(now())
  updatedAt                 DateTime                              @updatedAt
  contactedBy               IpAdminProfile?                       @relation("OrganisationRegistrationRequestContactedBy", fields: [contactedByIpAdminId], references: [id], onDelete: SetNull)
  approvedBy                IpAdminProfile?                       @relation("OrganisationRegistrationRequestApprovedBy", fields: [approvedByIpAdminId], references: [id], onDelete: SetNull)
  rejectedBy                IpAdminProfile?                       @relation("OrganisationRegistrationRequestRejectedBy", fields: [rejectedByIpAdminId], references: [id], onDelete: SetNull)
  approvedOrganisation      Organisation?                         @relation(fields: [approvedOrganisationId], references: [id], onDelete: SetNull)
  initialAdminInvitations   Invitation[]
  actionTokens              ActionToken[]
  emailDeliveryLogs         EmailDeliveryLog[]

  @@index([status])
  @@index([contactedByIpAdminId])
  @@index([approvedByIpAdminId])
  @@index([rejectedByIpAdminId])
  @@index([representativeEmail])
  @@index([approvedOrganisationId])
  @@index([contactedAt])
  @@index([approvedAt])
  @@index([rejectedAt])
}

model Invitation {
  id                                String                           @id @default(uuid())
  organisationId                    String
  organisationRegistrationRequestId String?
  recipientEmail                    String
  recipientFirstName                String?
  recipientLastName                 String?
  purpose                           InvitationPurpose                @default(INITIAL_ORGANISATION_ADMIN_SETUP)
  status                            InvitationStatus                 @default(PENDING)
  expiresAt                         DateTime
  acceptedAt                        DateTime?
  revokedAt                         DateTime?
  revokedReason                     String?
  createdAt                         DateTime                         @default(now())
  updatedAt                         DateTime                         @updatedAt
  organisation                      Organisation                     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationRegistrationRequest   OrganisationRegistrationRequest? @relation(fields: [organisationRegistrationRequestId], references: [id], onDelete: SetNull)
  actionTokens                      ActionToken[]
  emailDeliveryLogs                 EmailDeliveryLog[]

  @@index([organisationId])
  @@index([organisationRegistrationRequestId])
  @@index([recipientEmail])
  @@index([status])
  @@index([purpose])
  @@index([expiresAt])
}

model OrganisationContext {
  id               String                              @id @default(uuid())
  organisationId   String
  uploadedByUserId String?
  contextType      OrganisationContextType
  name             String
  description      String?
  contentSummary   String?
  contentRef       String?
  metadata         Json?
  processingStatus OrganisationContextProcessingStatus @default(UPLOADED)
  aiUsable         Boolean                             @default(false)
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  organisation     Organisation                        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  uploadedBy       User?                               @relation("OrganisationContextUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([uploadedByUserId])
  @@index([contextType])
  @@index([processingStatus])
}

model Campaign {
  id                   String                 @id @default(uuid())
  organisationId       String?
  createdByUserId      String?
  name                 String
  description          String?
  accentColor          String?
  campaignType         CampaignType
  difficultyLevel      DifficultyLevel        @default(BEGINNER)
  status               CampaignStatus         @default(DRAFT)
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  organisation         Organisation?          @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  createdBy            User?                  @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items                CampaignItem[]
  assignments          CampaignAssignment[]
  prerequisites        CampaignPrerequisite[] @relation("CampaignPrerequisites")
  requiredForCampaigns CampaignPrerequisite[] @relation("CampaignRequiredFor")

  @@index([organisationId])
  @@index([createdByUserId])
  @@index([campaignType])
  @@index([difficultyLevel])
  @@index([status])
}

model CampaignPrerequisite {
  id                     String                              @id @default(uuid())
  campaignId             String
  prerequisiteCampaignId String
  requirementType        CampaignPrerequisiteRequirementType @default(COMPLETION_REQUIRED)
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  campaign               Campaign                            @relation("CampaignPrerequisites", fields: [campaignId], references: [id], onDelete: Cascade)
  prerequisiteCampaign   Campaign                            @relation("CampaignRequiredFor", fields: [prerequisiteCampaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, prerequisiteCampaignId])
  @@index([campaignId])
  @@index([prerequisiteCampaignId])
}

model CampaignItem {
  id                           String                         @id @default(uuid())
  campaignId                   String
  parentGroupId                String?
  itemType                     CampaignItemType
  componentType                CampaignComponentType?
  groupType                    CampaignGroupType?
  completionRule               CompletionRule?
  title                        String
  description                  String?
  position                     Int
  difficultyLevel              DifficultyLevel?
  isRequired                   Boolean                        @default(true)
  availabilityStatus           CampaignItemAvailabilityStatus @default(AVAILABLE)
  trainingDocumentId           String?
  quizId                       String?
  simulationId                 String?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  campaign                     Campaign                       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parentGroup                  CampaignItem?                  @relation("CampaignItemGroup", fields: [parentGroupId], references: [id], onDelete: Cascade)
  childItems                   CampaignItem[]                 @relation("CampaignItemGroup")
  trainingDocument             TrainingDocument?              @relation(fields: [trainingDocumentId], references: [id], onDelete: SetNull)
  quiz                         Quiz?                          @relation(fields: [quizId], references: [id], onDelete: SetNull)
  simulation                   Simulation?                    @relation(fields: [simulationId], references: [id], onDelete: SetNull)
  campaignAssignments          CampaignAssignment[]
  quizAttempts                 QuizAttempt[]
  emailClassificationResponses EmailClassificationResponse[]
  interactionEvents            InteractionEvent[]

  @@unique([campaignId, parentGroupId, position])
  @@index([campaignId])
  @@index([parentGroupId])
  @@index([itemType])
  @@index([componentType])
  @@index([groupType])
  @@index([trainingDocumentId])
  @@index([quizId])
  @@index([simulationId])
  @@index([availabilityStatus])
}

model CampaignAssignment {
  id                           String                        @id @default(uuid())
  campaignId                   String
  traineeProfileId             String
  assignedByUserId             String?
  currentCampaignItemId        String?
  assignedAt                   DateTime                      @default(now())
  dueDate                      DateTime?
  startedAt                    DateTime?
  completedAt                  DateTime?
  assignmentStatus             AssignmentStatus              @default(ASSIGNED)
  accessType                   CampaignAccessType            @default(ASSIGNED)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  campaign                     Campaign                      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  traineeProfile               TraineeProfile                @relation(fields: [traineeProfileId], references: [id], onDelete: Cascade)
  assignedBy                   User?                         @relation("CampaignAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  currentCampaignItem          CampaignItem?                 @relation(fields: [currentCampaignItemId], references: [id], onDelete: SetNull)
  quizAttempts                 QuizAttempt[]
  emailClassificationResponses EmailClassificationResponse[]
  interactionEvents            InteractionEvent[]

  @@unique([campaignId, traineeProfileId])
  @@index([campaignId])
  @@index([traineeProfileId])
  @@index([assignedByUserId])
  @@index([currentCampaignItemId])
  @@index([assignmentStatus])
  @@index([accessType])
}

model TrainingDocument {
  id                       String                 @id @default(uuid())
  createdByUserId          String?
  title                    String
  contentType              TrainingContentType
  contentRef               String
  contentSummary           String?
  estimatedReadTimeMinutes Int?
  difficultyLevel          DifficultyLevel        @default(BEGINNER)
  status                   TrainingDocumentStatus @default(DRAFT)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  createdBy                User?                  @relation("TrainingDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campaignItems            CampaignItem[]
  interactionEvents        InteractionEvent[]

  @@index([createdByUserId])
  @@index([contentType])
  @@index([difficultyLevel])
  @@index([status])
}

model Quiz {
  id                      String             @id @default(uuid())
  createdByUserId         String?
  title                   String
  description             String?
  passThresholdPercentage Int
  difficultyLevel         DifficultyLevel    @default(BEGINNER)
  status                  QuizStatus         @default(DRAFT)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  createdBy               User?              @relation("QuizCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campaignItems           CampaignItem[]
  questions               QuizQuestion[]
  attempts                QuizAttempt[]
  interactionEvents       InteractionEvent[]

  @@index([createdByUserId])
  @@index([difficultyLevel])
  @@index([status])
}

model QuizQuestion {
  id                String             @id @default(uuid())
  quizId            String
  prompt            String
  questionType      QuestionType       @default(SINGLE_CHOICE)
  position          Int
  points            Int                @default(1)
  shuffleOptions    Boolean            @default(false)
  minSelections     Int?
  maxSelections     Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  quiz              Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answerOptions     AnswerOption[]
  attemptAnswers    AttemptAnswer[]
  interactionEvents InteractionEvent[]

  @@unique([quizId, position])
  @@index([quizId])
  @@index([questionType])
}

model AnswerOption {
  id                     String                @id @default(uuid())
  questionId             String
  label                  String
  text                   String
  isCorrect              Boolean               @default(false)
  position               Int
  feedbackText           String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  question               QuizQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAttemptAnswers AttemptAnswerOption[]

  @@unique([questionId, position])
  @@index([questionId])
}

model QuizAttempt {
  id                   String              @id @default(uuid())
  traineeProfileId     String
  quizId               String
  campaignAssignmentId String?
  campaignItemId       String?
  status               QuizAttemptStatus   @default(IN_PROGRESS)
  startedAt            DateTime            @default(now())
  submittedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  traineeProfile       TraineeProfile      @relation(fields: [traineeProfileId], references: [id], onDelete: Cascade)
  quiz                 Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  campaignAssignment   CampaignAssignment? @relation(fields: [campaignAssignmentId], references: [id], onDelete: SetNull)
  campaignItem         CampaignItem?       @relation(fields: [campaignItemId], references: [id], onDelete: SetNull)
  answers              AttemptAnswer[]
  quizResult           QuizResult?
  interactionEvents    InteractionEvent[]

  @@index([traineeProfileId])
  @@index([quizId])
  @@index([campaignAssignmentId])
  @@index([campaignItemId])
  @@index([status])
}

model AttemptAnswer {
  id              String                @id @default(uuid())
  attemptId       String
  questionId      String
  responseSummary String?
  typedResponse   String?
  isCorrect       Boolean?
  awardedPoints   Int?
  feedbackShown   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  attempt         QuizAttempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        QuizQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptions AttemptAnswerOption[]

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model AttemptAnswerOption {
  id              String        @id @default(uuid())
  attemptAnswerId String
  answerOptionId  String
  createdAt       DateTime      @default(now())
  attemptAnswer   AttemptAnswer @relation(fields: [attemptAnswerId], references: [id], onDelete: Cascade)
  answerOption    AnswerOption  @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)

  @@unique([attemptAnswerId, answerOptionId])
  @@index([attemptAnswerId])
  @@index([answerOptionId])
}

model QuizResult {
  id              String      @id @default(uuid())
  attemptId       String      @unique
  scorePercentage Int
  passed          Boolean
  summary         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  attempt         QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Simulation {
  id              String          @id @default(uuid())
  createdByUserId String?
  simulationType  SimulationType
  title           String
  description     String?
  objective       String?
  safetyStatus    SafetyStatus    @default(DRAFT)
  difficultyLevel DifficultyLevel @default(BEGINNER)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       User?           @relation("SimulationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campaignItems   CampaignItem[]
  simulatedInbox  SimulatedInbox?

  @@index([createdByUserId])
  @@index([simulationType])
  @@index([safetyStatus])
  @@index([difficultyLevel])
}

model SimulatedInbox {
  id           String           @id @default(uuid())
  simulationId String           @unique
  title        String
  description  String?
  status       InboxStatus      @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  simulation   Simulation       @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  emails       SimulatedEmail[]
}

model SimulatedEmail {
  id                      String                        @id @default(uuid())
  inboxId                 String
  senderLabel             String
  senderAddress           String
  subject                 String
  preview                 String?
  bodyHtml                String
  simulatedLinkTarget     String?
  hasAttachment           Boolean                       @default(false)
  receivedAt              DateTime                      @default(now())
  expectedClassification  EmailClassification
  difficultyLevel         DifficultyLevel               @default(BEGINNER)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  inbox                   SimulatedInbox                @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  redFlags                EmailRedFlag[]
  classificationResponses EmailClassificationResponse[]
  interactionEvents       InteractionEvent[]

  @@index([inboxId])
  @@index([receivedAt])
  @@index([expectedClassification])
  @@index([difficultyLevel])
}

model EmailRedFlag {
  id               String                               @id @default(uuid())
  simulatedEmailId String
  redFlagType      EmailRedFlagType
  label            String
  description      String?
  severity         RedFlagSeverity                      @default(MEDIUM)
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt
  simulatedEmail   SimulatedEmail                       @relation(fields: [simulatedEmailId], references: [id], onDelete: Cascade)
  selectedBy       EmailClassificationSelectedRedFlag[]

  @@index([simulatedEmailId])
  @@index([redFlagType])
  @@index([severity])
}

model EmailClassificationResponse {
  id                     String                               @id @default(uuid())
  traineeProfileId       String
  simulatedEmailId       String
  campaignAssignmentId   String?
  campaignItemId         String?
  selectedClassification EmailClassification
  reasonSummary          String?
  freeTextReason         String?
  isCorrect              Boolean
  submittedAt            DateTime                             @default(now())
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  traineeProfile         TraineeProfile                       @relation(fields: [traineeProfileId], references: [id], onDelete: Cascade)
  simulatedEmail         SimulatedEmail                       @relation(fields: [simulatedEmailId], references: [id], onDelete: Cascade)
  campaignAssignment     CampaignAssignment?                  @relation(fields: [campaignAssignmentId], references: [id], onDelete: SetNull)
  campaignItem           CampaignItem?                        @relation(fields: [campaignItemId], references: [id], onDelete: SetNull)
  selectedRedFlags       EmailClassificationSelectedRedFlag[]
  interactionEvents      InteractionEvent[]

  @@index([traineeProfileId])
  @@index([simulatedEmailId])
  @@index([campaignAssignmentId])
  @@index([campaignItemId])
  @@index([selectedClassification])
  @@index([submittedAt])
}

model EmailClassificationSelectedRedFlag {
  id                            String                      @id @default(uuid())
  emailClassificationResponseId String
  emailRedFlagId                String
  createdAt                     DateTime                    @default(now())
  emailClassificationResponse   EmailClassificationResponse @relation(fields: [emailClassificationResponseId], references: [id], onDelete: Cascade)
  emailRedFlag                  EmailRedFlag                @relation(fields: [emailRedFlagId], references: [id], onDelete: Cascade)

  @@unique([emailClassificationResponseId, emailRedFlagId])
  @@index([emailClassificationResponseId])
  @@index([emailRedFlagId])
}

model InteractionEvent {
  id                            String                       @id @default(uuid())
  traineeProfileId              String
  campaignAssignmentId          String?
  campaignItemId                String?
  eventType                     InteractionEventType
  targetType                    InteractionTargetType
  targetId                      String
  occurredAt                    DateTime                     @default(now())
  metadata                      Json?
  simulatedEmailId              String?
  trainingDocumentId            String?
  quizAttemptId                 String?
  quizId                        String?
  quizQuestionId                String?
  emailClassificationResponseId String?
  createdAt                     DateTime                     @default(now())
  traineeProfile                TraineeProfile               @relation(fields: [traineeProfileId], references: [id], onDelete: Cascade)
  campaignAssignment            CampaignAssignment?          @relation(fields: [campaignAssignmentId], references: [id], onDelete: SetNull)
  campaignItem                  CampaignItem?                @relation(fields: [campaignItemId], references: [id], onDelete: SetNull)
  simulatedEmail                SimulatedEmail?              @relation(fields: [simulatedEmailId], references: [id], onDelete: SetNull)
  trainingDocument              TrainingDocument?            @relation(fields: [trainingDocumentId], references: [id], onDelete: SetNull)
  quizAttempt                   QuizAttempt?                 @relation(fields: [quizAttemptId], references: [id], onDelete: SetNull)
  quiz                          Quiz?                        @relation(fields: [quizId], references: [id], onDelete: SetNull)
  quizQuestion                  QuizQuestion?                @relation(fields: [quizQuestionId], references: [id], onDelete: SetNull)
  emailClassificationResponse   EmailClassificationResponse? @relation(fields: [emailClassificationResponseId], references: [id], onDelete: SetNull)

  @@index([traineeProfileId])
  @@index([campaignAssignmentId])
  @@index([campaignItemId])
  @@index([eventType])
  @@index([targetType, targetId])
  @@index([simulatedEmailId])
  @@index([trainingDocumentId])
  @@index([quizAttemptId])
  @@index([quizId])
  @@index([quizQuestionId])
  @@index([emailClassificationResponseId])
  @@index([occurredAt])
}

model AuditLogEntry {
  id             String          @id @default(uuid())
  actorUserId    String?
  actorType      AuditActorType
  organisationId String?
  targetType     AuditTargetType
  targetId       String?
  actionType     AuditActionType
  outcome        AuditOutcome
  oldValues      Json?
  newValues      Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime        @default(now())

  actorUser    User?         @relation("AuditLogEntryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([organisationId])
  @@index([actorType])
  @@index([targetType, targetId])
  @@index([actionType])
  @@index([outcome])
  @@index([createdAt])
  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
}
