generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  IP_ADMIN
  COMPANY_ADMIN
  COMPANY_LEARNER
  GENERAL_LEARNER
}

enum AuthStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum ContextStatus {
  NOT_PROVIDED
  PROVIDED
  NEEDS_REVIEW
}

enum OrganisationRole {
  ADMIN
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum CampaignType {
  ORGANISATION_ASSIGNED
  PREMADE_GENERAL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LearningPathStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SimulationType {
  PHISHING_EMAIL
}

enum SafetyStatus {
  DRAFT
  APPROVED
  BLOCKED
}

enum InboxStatus {
  ACTIVE
  ARCHIVED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingContentType {
  MARKDOWN
  HTML
  URL
}

enum TrainingDocumentStatus {
  AVAILABLE
  UNAVAILABLE
  ARCHIVED
}

enum TrainingProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum FeedbackType {
  SUCCESS
  WARNING
  ERROR
  INFO
}

enum InteractionEventType {
  EMAIL_OPENED
  EMAIL_LINK_CLICKED
  CREDENTIAL_SUBMISSION_ATTEMPTED
  TRAINING_VIEWED
  TRAINING_COMPLETED
  QUIZ_STARTED
  QUIZ_ANSWER_SUBMITTED
  QUIZ_COMPLETED
}

enum InteractionTargetType {
  SIMULATED_EMAIL
  TRAINING_DOCUMENT
  QUIZ
  QUIZ_ATTEMPT
  QUIZ_QUESTION
}

model HealthCheck {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
}

enum GeneralLearningAccessSource {
  SELF_SIGNUP
  INVITE
  SEED
  ADMIN_CREATED
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  passwordHash            String
  userType                UserType
  authStatus              AuthStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organisationMemberships OrganisationMembership[]
  generalLearningAccess   GeneralLearningAccess?
  campaignAssignments     CampaignAssignment[]
  simulatedInbox          SimulatedInbox?
  trainingProgress        TrainingProgress[]
  quizAttempts            QuizAttempt[]
  interactionEvents       InteractionEvent[]
}

model Organisation {
  id             String                   @id @default(uuid())
  name           String                   @unique
  contextStatus  ContextStatus            @default(NOT_PROVIDED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  memberships    OrganisationMembership[]
  companyContext CompanyContext?
  campaigns      Campaign[]
  departments    Department[]
}

model OrganisationMembership {
  id                  String               @id @default(uuid())
  userId              String
  organisationId      String
  role                OrganisationRole
  status              MembershipStatus     @default(ACTIVE)
  departmentId        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  campaignAssignments CampaignAssignment[]

  @@unique([userId, organisationId])
  @@index([userId])
  @@index([organisationId])
  @@index([departmentId])
}

model GeneralLearningAccess {
  id         String                      @id @default(uuid())
  userId     String                      @unique
  assignedAt DateTime                    @default(now())
  source     GeneralLearningAccessSource @default(SELF_SIGNUP)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id             String                   @id @default(uuid())
  organisationId String
  name           String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organisation   Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships    OrganisationMembership[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

model CompanyContext {
  id             String       @id @default(uuid())
  organisationId String       @unique
  industry       String?
  terminology    Json?
  safetyNotes    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model Campaign {
  id             String               @id @default(uuid())
  organisationId String?
  name           String
  description    String?
  campaignType   CampaignType
  status         CampaignStatus       @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organisation   Organisation?        @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  assignments    CampaignAssignment[]
  simulations    Simulation[]
  learningPaths  LearningPath[]

  @@index([organisationId])
  @@index([campaignType])
  @@index([status])
}

model CampaignAssignment {
  id               String                 @id @default(uuid())
  campaignId       String
  userId           String
  membershipId     String
  assignedAt       DateTime               @default(now())
  assignmentStatus AssignmentStatus       @default(ASSIGNED)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  campaign         Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership       OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  trainingProgress TrainingProgress[]
  quizAttempts     QuizAttempt[]

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@index([membershipId])
}

model LearningPath {
  id              String             @id @default(uuid())
  campaignId      String
  title           String
  status          LearningPathStatus @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  campaign        Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trainingModules TrainingModule[]

  @@index([campaignId])
  @@index([status])
}

model Simulation {
  id              String           @id @default(uuid())
  campaignId      String
  simulationType  SimulationType
  objective       String?
  safetyStatus    SafetyStatus     @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  simulatedEmails SimulatedEmail[]

  @@index([campaignId])
  @@index([simulationType])
  @@index([safetyStatus])
}

model SimulatedInbox {
  id          String           @id @default(uuid())
  ownerUserId String           @unique
  status      InboxStatus      @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  owner       User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  emails      SimulatedEmail[]
}

model SimulatedEmail {
  id                            String             @id @default(uuid())
  inboxId                       String
  simulationId                  String
  recommendedTrainingDocumentId String?
  senderLabel                   String
  senderAddress                 String
  subject                       String
  preview                       String?
  bodyHtml                      String
  receivedAt                    DateTime           @default(now())
  isRead                        Boolean            @default(false)
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  inbox                         SimulatedInbox     @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  simulation                    Simulation         @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  recommendedTrainingDocument   TrainingDocument?  @relation(fields: [recommendedTrainingDocumentId], references: [id], onDelete: SetNull)
  interactionEvents             InteractionEvent[]

  @@index([inboxId])
  @@index([simulationId])
  @@index([recommendedTrainingDocumentId])
  @@index([receivedAt])
}

model TrainingModule {
  id             String             @id @default(uuid())
  learningPathId String?
  title          String
  order          Int
  description    String?
  difficulty     DifficultyLevel    @default(BEGINNER)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  learningPath   LearningPath?      @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  documents      TrainingDocument[]

  @@unique([learningPathId, order])
  @@index([learningPathId])
}

model TrainingDocument {
  id                           String                 @id @default(uuid())
  moduleId                     String
  title                        String
  contentType                  TrainingContentType
  contentRef                   String
  status                       TrainingDocumentStatus @default(AVAILABLE)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  module                       TrainingModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  recommendedBySimulatedEmails SimulatedEmail[]
  trainingProgress             TrainingProgress[]
  quizzes                      Quiz[]
  interactionEvents            InteractionEvent[]

  @@index([moduleId])
  @@index([status])
}

model TrainingProgress {
  id                   String                 @id @default(uuid())
  userId               String
  trainingDocumentId   String
  campaignAssignmentId String?
  status               TrainingProgressStatus @default(NOT_STARTED)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingDocument     TrainingDocument       @relation(fields: [trainingDocumentId], references: [id], onDelete: Cascade)
  campaignAssignment   CampaignAssignment?    @relation(fields: [campaignAssignmentId], references: [id], onDelete: SetNull)
  quizAttempts         QuizAttempt[]

  @@unique([userId, trainingDocumentId, campaignAssignmentId])
  @@index([userId])
  @@index([trainingDocumentId])
  @@index([campaignAssignmentId])
  @@index([status])
}

model Quiz {
  id                      String             @id @default(uuid())
  trainingDocumentId      String?
  title                   String
  passThresholdPercentage Int
  status                  QuizStatus         @default(DRAFT)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  trainingDocument        TrainingDocument?  @relation(fields: [trainingDocumentId], references: [id], onDelete: SetNull)
  questions               QuizQuestion[]
  attempts                QuizAttempt[]
  interactionEvents       InteractionEvent[]

  @@index([trainingDocumentId])
  @@index([status])
}

model QuizQuestion {
  id                String             @id @default(uuid())
  quizId            String
  prompt            String
  questionType      QuestionType       @default(SINGLE_CHOICE)
  order             Int
  points            Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  quiz              Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answerOptions     AnswerOption[]
  attemptAnswers    AttemptAnswer[]
  feedbackItems     FeedbackItem[]
  interactionEvents InteractionEvent[]

  @@unique([quizId, order])
  @@index([quizId])
}

model AnswerOption {
  id             String          @id @default(uuid())
  questionId     String
  label          String
  text           String
  isCorrect      Boolean         @default(false)
  order          Int
  feedback       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  question       QuizQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers AttemptAnswer[]

  @@unique([questionId, order])
  @@index([questionId])
}

model QuizAttempt {
  id                   String              @id @default(uuid())
  userId               String
  quizId               String
  campaignAssignmentId String?
  trainingProgressId   String?
  status               QuizAttemptStatus   @default(IN_PROGRESS)
  startedAt            DateTime            @default(now())
  submittedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz                 Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  campaignAssignment   CampaignAssignment? @relation(fields: [campaignAssignmentId], references: [id], onDelete: SetNull)
  trainingProgress     TrainingProgress?   @relation(fields: [trainingProgressId], references: [id], onDelete: SetNull)
  answers              AttemptAnswer[]
  quizResult           QuizResult?
  interactionEvents    InteractionEvent[]

  @@index([userId])
  @@index([quizId])
  @@index([campaignAssignmentId])
  @@index([trainingProgressId])
  @@index([status])
}

model AttemptAnswer {
  id               String         @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  attempt          QuizAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   AnswerOption   @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  feedbackItems    FeedbackItem[]

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([selectedOptionId])
}

model QuizResult {
  id              String         @id @default(uuid())
  attemptId       String         @unique
  scorePercentage Int
  passed          Boolean
  summary         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  attempt         QuizAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  feedbackItems   FeedbackItem[]
}

model FeedbackItem {
  id              String         @id @default(uuid())
  quizResultId    String
  questionId      String
  attemptAnswerId String?
  isCorrect       Boolean
  explanation     String
  feedbackType    FeedbackType
  linkedTopic     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  quizResult      QuizResult     @relation(fields: [quizResultId], references: [id], onDelete: Cascade)
  question        QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswer   AttemptAnswer? @relation(fields: [attemptAnswerId], references: [id], onDelete: SetNull)

  @@index([quizResultId])
  @@index([questionId])
  @@index([attemptAnswerId])
  @@index([feedbackType])
}

model InteractionEvent {
  id                 String                @id @default(uuid())
  userId             String
  eventType          InteractionEventType
  targetType         InteractionTargetType
  targetId           String
  occurredAt         DateTime              @default(now())
  metadata           Json?
  simulatedEmailId   String?
  trainingDocumentId String?
  quizAttemptId      String?
  quizId             String?
  quizQuestionId     String?
  createdAt          DateTime              @default(now())
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulatedEmail     SimulatedEmail?       @relation(fields: [simulatedEmailId], references: [id], onDelete: SetNull)
  trainingDocument   TrainingDocument?     @relation(fields: [trainingDocumentId], references: [id], onDelete: SetNull)
  quizAttempt        QuizAttempt?          @relation(fields: [quizAttemptId], references: [id], onDelete: SetNull)
  quiz               Quiz?                 @relation(fields: [quizId], references: [id], onDelete: SetNull)
  quizQuestion       QuizQuestion?         @relation(fields: [quizQuestionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([targetType, targetId])
  @@index([simulatedEmailId])
  @@index([trainingDocumentId])
  @@index([quizAttemptId])
  @@index([quizId])
  @@index([quizQuestionId])
  @@index([occurredAt])
}
