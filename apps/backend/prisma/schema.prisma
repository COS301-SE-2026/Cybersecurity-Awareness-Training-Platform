generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  ADMIN
  EMPLOYEE
  GENERAL_LEARNER
}

enum AuthStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum ContextStatus {
  NOT_PROVIDED
  PROVIDED
  NEEDS_REVIEW
}

enum OrganisationRole {
  ADMIN
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum CampaignType {
  ORGANISATION_ASSIGNED
  PREMADE_GENERAL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LearningPathContextType {
  ORGANISATION
  PREMADE_GENERAL
}

enum LearningPathStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SimulationType {
  PHISHING_EMAIL
}

enum SafetyStatus {
  DRAFT
  APPROVED
  BLOCKED
}

enum InboxSummaryStatus {
  ACTIVE
  ARCHIVED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingContentType {
  MARKDOWN
  HTML
  URL
}

enum ReadableStatus {
  AVAILABLE
  UNAVAILABLE
  ARCHIVED
}

enum TrainingProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model HealthCheck {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  passwordHash            String
  userType                UserType
  authStatus              AuthStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organisationMemberships OrganisationMembership[]
  generalLearningAccess   GeneralLearningAccess?
  campaignAssignments     CampaignAssignment[]
  simulatedInbox          SimulatedInbox?
  trainingProgress        TrainingProgress[]
}

model Organisation {
  id             String                   @id @default(uuid())
  name           String
  contextStatus  ContextStatus            @default(NOT_PROVIDED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  memberships    OrganisationMembership[]
  companyContext CompanyContext?
  campaigns      Campaign[]
}

model OrganisationMembership {
  id                  String               @id @default(uuid())
  userId              String
  organisationId      String
  role                OrganisationRole
  status              MembershipStatus     @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  campaignAssignments CampaignAssignment[]

  @@unique([userId, organisationId])
  @@index([userId])
  @@index([organisationId])
}

model GeneralLearningAccess {
  id         String   @id @default(uuid())
  userId     String   @unique
  assignedAt DateTime @default(now())
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyContext {
  id             String       @id @default(uuid())
  organisationId String       @unique
  industry       String?
  departments    Json?
  terminology    Json?
  safetyNotes    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model Campaign {
  id             String               @id @default(uuid())
  organisationId String?
  name           String
  campaignType   CampaignType
  status         CampaignStatus       @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organisation   Organisation?        @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  assignments    CampaignAssignment[]
  simulations    Simulation[]
  learningPaths  LearningPath[]

  @@index([organisationId])
  @@index([campaignType])
  @@index([status])
}

model CampaignAssignment {
  id               String                  @id @default(uuid())
  campaignId       String
  userId           String
  membershipId     String?
  assignedAt       DateTime                @default(now())
  assignmentStatus AssignmentStatus        @default(ASSIGNED)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  campaign         Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership       OrganisationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@index([membershipId])
}

model LearningPath {
  id              String                  @id @default(uuid())
  campaignId      String
  title           String
  contextType     LearningPathContextType
  status          LearningPathStatus      @default(DRAFT)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  campaign        Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trainingModules TrainingModule[]

  @@index([campaignId])
  @@index([status])
}

model Simulation {
  id              String           @id @default(uuid())
  campaignId      String
  simulationType  SimulationType
  objective       String?
  safetyStatus    SafetyStatus     @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  simulatedEmails SimulatedEmail[]

  @@index([campaignId])
  @@index([simulationType])
  @@index([safetyStatus])
}

model SimulatedInbox {
  id            String             @id @default(uuid())
  ownerUserId   String             @unique
  summaryStatus InboxSummaryStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  owner         User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  emails        SimulatedEmail[]
}

model SimulatedEmail {
  id                 String            @id @default(uuid())
  inboxId            String
  simulationId       String?
  trainingDocumentId String?
  senderLabel        String
  senderEmail        String?
  subject            String
  preview            String?
  body               String
  isSimulated        Boolean           @default(true)
  receivedAt         DateTime          @default(now())
  isRead             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  inbox              SimulatedInbox    @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  simulation         Simulation?       @relation(fields: [simulationId], references: [id], onDelete: SetNull)
  trainingDocument   TrainingDocument? @relation(fields: [trainingDocumentId], references: [id], onDelete: SetNull)

  @@index([inboxId])
  @@index([simulationId])
  @@index([trainingDocumentId])
  @@index([receivedAt])
}

model TrainingModule {
  id             String             @id @default(uuid())
  learningPathId String?
  title          String
  description    String?
  difficulty     DifficultyLevel    @default(BEGINNER)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  learningPath   LearningPath?      @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  documents      TrainingDocument[]

  @@index([learningPathId])
}

model TrainingDocument {
  id               String              @id @default(uuid())
  moduleId         String
  title            String
  contentType      TrainingContentType
  contentRef       String
  readableStatus   ReadableStatus      @default(AVAILABLE)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  module           TrainingModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  simulatedEmails  SimulatedEmail[]
  trainingProgress TrainingProgress[]

  @@index([moduleId])
  @@index([readableStatus])
}

model TrainingProgress {
  id                 String                 @id @default(uuid())
  userId             String
  trainingDocumentId String
  status             TrainingProgressStatus @default(NOT_STARTED)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingDocument   TrainingDocument       @relation(fields: [trainingDocumentId], references: [id], onDelete: Cascade)

  @@unique([userId, trainingDocumentId])
  @@index([userId])
  @@index([trainingDocumentId])
  @@index([status])
}
