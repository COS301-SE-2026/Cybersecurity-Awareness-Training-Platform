generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  IP_ADMIN
  ORGANISATION_ADMIN
  ORGANISATION_LEARNER
  GENERAL_LEARNER
}

enum AuthStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum LearnerStatus {
  ACTIVE
  INACTIVE
}

enum OrganisationUserStatus {
  ACTIVE
  INACTIVE
}

enum AdminStatus {
  ACTIVE
  INACTIVE
}

enum GeneralLearnerAccessSource {
  SELF_SIGNUP
  INVITE
  SEED
  ADMIN_CREATED
}

enum OrganisationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrganisationContextType {
  LOGO
  BRAND_GUIDELINES
  SECURITY_POLICY
  STAFF_STRUCTURE
  INTERNAL_TERMINOLOGY
  APPROVED_DOMAINS
  EMAIL_SIGNATURE_FORMAT
  OTHER
}

enum OrganisationContextProcessingStatus {
  UPLOADED
  PROCESSING
  READY
  NEEDS_REVIEW
  ARCHIVED
}

enum CampaignType {
  PREMADE_GENERAL
  ORGANISATION_CUSTOM
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ADAPTIVE
}

enum CampaignItemType {
  COMPONENT
  GROUP
}

enum CampaignComponentType {
  TRAINING_DOCUMENT
  QUIZ
  SIMULATED_INBOX
}

enum CampaignGroupType {
  SECTION
  MODULE
  REVISION_SET
  ASSESSMENT_SET
  SIMULATION_SET
}

enum CompletionRule {
  COMPLETE_ALL
  COMPLETE_ANY
  COMPLETE_REQUIRED_ONLY
}

enum CampaignItemAvailabilityStatus {
  AVAILABLE
  LOCKED
  UNAVAILABLE
  ARCHIVED
}

enum AssignmentStatus {
  AVAILABLE
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum CampaignAccessType {
  ASSIGNED
  SELF_SELECTED
}

enum CampaignPrerequisiteRequirementType {
  COMPLETION_REQUIRED
}

enum TrainingContentType {
  PDF
  MARKDOWN
  HTML
  URL
  INTERACTIVE
}

enum TrainingDocumentStatus {
  DRAFT
  AVAILABLE
  UNAVAILABLE
  ARCHIVED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum SimulationType {
  SIMULATED_INBOX
}

enum SafetyStatus {
  DRAFT
  APPROVED
  BLOCKED
}

enum InboxStatus {
  ACTIVE
  ARCHIVED
}

enum EmailClassification {
  SAFE
  SUSPICIOUS
  PHISHING
}

enum EmailRedFlagType {
  SENDER
  LINK
  LANGUAGE
  ATTACHMENT
  REQUEST
  DOMAIN
  OTHER
}

enum RedFlagSeverity {
  LOW
  MEDIUM
  HIGH
}

enum InteractionEventType {
  CAMPAIGN_STARTED
  CAMPAIGN_ITEM_STARTED
  CAMPAIGN_ITEM_COMPLETED
  TRAINING_VIEWED
  TRAINING_COMPLETED
  QUIZ_STARTED
  QUIZ_ANSWER_SUBMITTED
  QUIZ_COMPLETED
  SIMULATED_EMAIL_OPENED
  SIMULATED_EMAIL_LINK_CLICKED
  SIMULATED_EMAIL_CLASSIFIED
  CREDENTIAL_SUBMISSION_ATTEMPTED
}

enum InteractionTargetType {
  CAMPAIGN
  CAMPAIGN_ITEM
  CAMPAIGN_COMPONENT
  TRAINING_DOCUMENT
  QUIZ
  QUIZ_ATTEMPT
  QUIZ_QUESTION
  SIMULATED_EMAIL
  EMAIL_CLASSIFICATION_RESPONSE
}

model HealthCheck {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
}

model User {
  id                           String                    @id @default(uuid())
  firstName                    String
  lastName                     String
  email                        String                    @unique
  passwordHash                 String
  userType                     UserType
  authStatus                   AuthStatus                @default(ACTIVE)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  learnerProfile               LearnerProfile?
  organisationAdminProfile     OrganisationAdminProfile?
  ipAdminProfile               IpAdminProfile?
  uploadedOrganisationContexts OrganisationContext[]     @relation("OrganisationContextUploadedBy")
  createdCampaigns             Campaign[]                @relation("CampaignCreatedBy")
  assignedCampaignAssignments  CampaignAssignment[]      @relation("CampaignAssignmentAssignedBy")
  createdTrainingDocuments     TrainingDocument[]        @relation("TrainingDocumentCreatedBy")
  createdQuizzes               Quiz[]                    @relation("QuizCreatedBy")
  createdSimulations           Simulation[]              @relation("SimulationCreatedBy")
}

model LearnerProfile {
  id                           String                        @id @default(uuid())
  userId                       String                        @unique
  learnerStatus                LearnerStatus                 @default(ACTIVE)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  generalLearnerProfile        GeneralLearnerProfile?
  organisationLearnerProfile   OrganisationLearnerProfile?
  campaignAssignments          CampaignAssignment[]
  quizAttempts                 QuizAttempt[]
  emailClassificationResponses EmailClassificationResponse[]
  interactionEvents            InteractionEvent[]

  @@index([learnerStatus])
}

model GeneralLearnerProfile {
  id               String                     @id @default(uuid())
  learnerProfileId String                     @unique
  accessSource     GeneralLearnerAccessSource @default(SELF_SIGNUP)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  learnerProfile   LearnerProfile             @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
}

model OrganisationLearnerProfile {
  id                     String                 @id @default(uuid())
  learnerProfileId       String                 @unique
  organisationId         String
  employeeLabel          String?
  joinedAt               DateTime               @default(now())
  organisationUserStatus OrganisationUserStatus @default(ACTIVE)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  learnerProfile         LearnerProfile         @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  organisation           Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([organisationUserStatus])
}

model OrganisationAdminProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  organisationId String
  adminStatus    AdminStatus  @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([adminStatus])
}

model IpAdminProfile {
  id          String      @id @default(uuid())
  userId      String      @unique
  adminStatus AdminStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organisation {
  id              String                       @id @default(uuid())
  name            String                       @unique
  status          OrganisationStatus           @default(ACTIVE)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  learnerProfiles OrganisationLearnerProfile[]
  adminProfiles   OrganisationAdminProfile[]
  contexts        OrganisationContext[]
  campaigns       Campaign[]
}

model OrganisationContext {
  id               String                              @id @default(uuid())
  organisationId   String
  uploadedByUserId String?
  contextType      OrganisationContextType
  name             String
  description      String?
  contentSummary   String?
  contentRef       String?
  metadata         Json?
  processingStatus OrganisationContextProcessingStatus @default(UPLOADED)
  aiUsable         Boolean                             @default(false)
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  organisation     Organisation                        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  uploadedBy       User?                               @relation("OrganisationContextUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([uploadedByUserId])
  @@index([contextType])
  @@index([processingStatus])
}

model Campaign {
  id                   String                 @id @default(uuid())
  organisationId       String?
  createdByUserId      String?
  name                 String
  description          String?
  campaignType         CampaignType
  difficultyLevel      DifficultyLevel        @default(BEGINNER)
  status               CampaignStatus         @default(DRAFT)
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  organisation         Organisation?          @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  createdBy            User?                  @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items                CampaignItem[]
  assignments          CampaignAssignment[]
  prerequisites        CampaignPrerequisite[] @relation("CampaignPrerequisites")
  requiredForCampaigns CampaignPrerequisite[] @relation("CampaignRequiredFor")

  @@index([organisationId])
  @@index([createdByUserId])
  @@index([campaignType])
  @@index([difficultyLevel])
  @@index([status])
}

model CampaignPrerequisite {
  id                     String                              @id @default(uuid())
  campaignId             String
  prerequisiteCampaignId String
  requirementType        CampaignPrerequisiteRequirementType @default(COMPLETION_REQUIRED)
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  campaign               Campaign                            @relation("CampaignPrerequisites", fields: [campaignId], references: [id], onDelete: Cascade)
  prerequisiteCampaign   Campaign                            @relation("CampaignRequiredFor", fields: [prerequisiteCampaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, prerequisiteCampaignId])
  @@index([campaignId])
  @@index([prerequisiteCampaignId])
}

model CampaignItem {
  id                           String                         @id @default(uuid())
  campaignId                   String
  parentGroupId                String?
  itemType                     CampaignItemType
  componentType                CampaignComponentType?
  groupType                    CampaignGroupType?
  completionRule               CompletionRule?
  title                        String
  description                  String?
  position                     Int
  difficultyLevel              DifficultyLevel?
  isRequired                   Boolean                        @default(true)
  availabilityStatus           CampaignItemAvailabilityStatus @default(AVAILABLE)
  trainingDocumentId           String?
  quizId                       String?
  simulationId                 String?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  campaign                     Campaign                       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parentGroup                  CampaignItem?                  @relation("CampaignItemGroup", fields: [parentGroupId], references: [id], onDelete: Cascade)
  childItems                   CampaignItem[]                 @relation("CampaignItemGroup")
  trainingDocument             TrainingDocument?              @relation(fields: [trainingDocumentId], references: [id], onDelete: SetNull)
  quiz                         Quiz?                          @relation(fields: [quizId], references: [id], onDelete: SetNull)
  simulation                   Simulation?                    @relation(fields: [simulationId], references: [id], onDelete: SetNull)
  campaignAssignments          CampaignAssignment[]
  quizAttempts                 QuizAttempt[]
  emailClassificationResponses EmailClassificationResponse[]
  interactionEvents            InteractionEvent[]

  @@unique([campaignId, parentGroupId, position])
  @@index([campaignId])
  @@index([parentGroupId])
  @@index([itemType])
  @@index([componentType])
  @@index([groupType])
  @@index([trainingDocumentId])
  @@index([quizId])
  @@index([simulationId])
  @@index([availabilityStatus])
}

model CampaignAssignment {
  id                           String                        @id @default(uuid())
  campaignId                   String
  learnerProfileId             String
  assignedByUserId             String?
  currentCampaignItemId        String?
  assignedAt                   DateTime                      @default(now())
  dueDate                      DateTime?
  startedAt                    DateTime?
  completedAt                  DateTime?
  assignmentStatus             AssignmentStatus              @default(ASSIGNED)
  accessType                   CampaignAccessType            @default(ASSIGNED)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  campaign                     Campaign                      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  learnerProfile               LearnerProfile                @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  assignedBy                   User?                         @relation("CampaignAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  currentCampaignItem          CampaignItem?                 @relation(fields: [currentCampaignItemId], references: [id], onDelete: SetNull)
  quizAttempts                 QuizAttempt[]
  emailClassificationResponses EmailClassificationResponse[]
  interactionEvents            InteractionEvent[]

  @@unique([campaignId, learnerProfileId])
  @@index([campaignId])
  @@index([learnerProfileId])
  @@index([assignedByUserId])
  @@index([currentCampaignItemId])
  @@index([assignmentStatus])
  @@index([accessType])
}

model TrainingDocument {
  id                       String                 @id @default(uuid())
  createdByUserId          String?
  title                    String
  contentType              TrainingContentType
  contentRef               String
  contentSummary           String?
  estimatedReadTimeMinutes Int?
  difficultyLevel          DifficultyLevel        @default(BEGINNER)
  status                   TrainingDocumentStatus @default(DRAFT)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  createdBy                User?                  @relation("TrainingDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campaignItems            CampaignItem[]
  interactionEvents        InteractionEvent[]

  @@index([createdByUserId])
  @@index([contentType])
  @@index([difficultyLevel])
  @@index([status])
}

model Quiz {
  id                      String             @id @default(uuid())
  createdByUserId         String?
  title                   String
  description             String?
  passThresholdPercentage Int
  difficultyLevel         DifficultyLevel    @default(BEGINNER)
  status                  QuizStatus         @default(DRAFT)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  createdBy               User?              @relation("QuizCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campaignItems           CampaignItem[]
  questions               QuizQuestion[]
  attempts                QuizAttempt[]
  interactionEvents       InteractionEvent[]

  @@index([createdByUserId])
  @@index([difficultyLevel])
  @@index([status])
}

model QuizQuestion {
  id                String             @id @default(uuid())
  quizId            String
  prompt            String
  questionType      QuestionType       @default(SINGLE_CHOICE)
  position          Int
  points            Int                @default(1)
  shuffleOptions    Boolean            @default(false)
  minSelections     Int?
  maxSelections     Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  quiz              Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answerOptions     AnswerOption[]
  attemptAnswers    AttemptAnswer[]
  interactionEvents InteractionEvent[]

  @@unique([quizId, position])
  @@index([quizId])
  @@index([questionType])
}

model AnswerOption {
  id                     String                @id @default(uuid())
  questionId             String
  label                  String
  text                   String
  isCorrect              Boolean               @default(false)
  position               Int
  feedbackText           String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  question               QuizQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAttemptAnswers AttemptAnswerOption[]

  @@unique([questionId, position])
  @@index([questionId])
}

model QuizAttempt {
  id                   String              @id @default(uuid())
  learnerProfileId     String
  quizId               String
  campaignAssignmentId String?
  campaignItemId       String?
  status               QuizAttemptStatus   @default(IN_PROGRESS)
  startedAt            DateTime            @default(now())
  submittedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  learnerProfile       LearnerProfile      @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  quiz                 Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  campaignAssignment   CampaignAssignment? @relation(fields: [campaignAssignmentId], references: [id], onDelete: SetNull)
  campaignItem         CampaignItem?       @relation(fields: [campaignItemId], references: [id], onDelete: SetNull)
  answers              AttemptAnswer[]
  quizResult           QuizResult?
  interactionEvents    InteractionEvent[]

  @@index([learnerProfileId])
  @@index([quizId])
  @@index([campaignAssignmentId])
  @@index([campaignItemId])
  @@index([status])
}

model AttemptAnswer {
  id              String                @id @default(uuid())
  attemptId       String
  questionId      String
  responseSummary String?
  typedResponse   String?
  isCorrect       Boolean?
  awardedPoints   Int?
  feedbackShown   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  attempt         QuizAttempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        QuizQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptions AttemptAnswerOption[]

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model AttemptAnswerOption {
  id              String        @id @default(uuid())
  attemptAnswerId String
  answerOptionId  String
  createdAt       DateTime      @default(now())
  attemptAnswer   AttemptAnswer @relation(fields: [attemptAnswerId], references: [id], onDelete: Cascade)
  answerOption    AnswerOption  @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)

  @@unique([attemptAnswerId, answerOptionId])
  @@index([attemptAnswerId])
  @@index([answerOptionId])
}

model QuizResult {
  id              String      @id @default(uuid())
  attemptId       String      @unique
  scorePercentage Int
  passed          Boolean
  summary         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  attempt         QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Simulation {
  id              String          @id @default(uuid())
  createdByUserId String?
  simulationType  SimulationType
  title           String
  description     String?
  objective       String?
  safetyStatus    SafetyStatus    @default(DRAFT)
  difficultyLevel DifficultyLevel @default(BEGINNER)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       User?           @relation("SimulationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campaignItems   CampaignItem[]
  simulatedInbox  SimulatedInbox?

  @@index([createdByUserId])
  @@index([simulationType])
  @@index([safetyStatus])
  @@index([difficultyLevel])
}

model SimulatedInbox {
  id           String           @id @default(uuid())
  simulationId String           @unique
  title        String
  description  String?
  status       InboxStatus      @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  simulation   Simulation       @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  emails       SimulatedEmail[]
}

model SimulatedEmail {
  id                      String                        @id @default(uuid())
  inboxId                 String
  senderLabel             String
  senderAddress           String
  subject                 String
  preview                 String?
  bodyHtml                String
  simulatedLinkTarget     String?
  hasAttachment           Boolean                       @default(false)
  receivedAt              DateTime                      @default(now())
  expectedClassification  EmailClassification
  difficultyLevel         DifficultyLevel               @default(BEGINNER)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  inbox                   SimulatedInbox                @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  redFlags                EmailRedFlag[]
  classificationResponses EmailClassificationResponse[]
  interactionEvents       InteractionEvent[]

  @@index([inboxId])
  @@index([receivedAt])
  @@index([expectedClassification])
  @@index([difficultyLevel])
}

model EmailRedFlag {
  id               String                               @id @default(uuid())
  simulatedEmailId String
  redFlagType      EmailRedFlagType
  label            String
  description      String?
  severity         RedFlagSeverity                      @default(MEDIUM)
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt
  simulatedEmail   SimulatedEmail                       @relation(fields: [simulatedEmailId], references: [id], onDelete: Cascade)
  selectedBy       EmailClassificationSelectedRedFlag[]

  @@index([simulatedEmailId])
  @@index([redFlagType])
  @@index([severity])
}

model EmailClassificationResponse {
  id                     String                               @id @default(uuid())
  learnerProfileId       String
  simulatedEmailId       String
  campaignAssignmentId   String?
  campaignItemId         String?
  selectedClassification EmailClassification
  reasonSummary          String?
  freeTextReason         String?
  isCorrect              Boolean
  submittedAt            DateTime                             @default(now())
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  learnerProfile         LearnerProfile                       @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  simulatedEmail         SimulatedEmail                       @relation(fields: [simulatedEmailId], references: [id], onDelete: Cascade)
  campaignAssignment     CampaignAssignment?                  @relation(fields: [campaignAssignmentId], references: [id], onDelete: SetNull)
  campaignItem           CampaignItem?                        @relation(fields: [campaignItemId], references: [id], onDelete: SetNull)
  selectedRedFlags       EmailClassificationSelectedRedFlag[]
  interactionEvents      InteractionEvent[]

  @@index([learnerProfileId])
  @@index([simulatedEmailId])
  @@index([campaignAssignmentId])
  @@index([campaignItemId])
  @@index([selectedClassification])
  @@index([submittedAt])
}

model EmailClassificationSelectedRedFlag {
  id                            String                      @id @default(uuid())
  emailClassificationResponseId String
  emailRedFlagId                String
  createdAt                     DateTime                    @default(now())
  emailClassificationResponse   EmailClassificationResponse @relation(fields: [emailClassificationResponseId], references: [id], onDelete: Cascade)
  emailRedFlag                  EmailRedFlag                @relation(fields: [emailRedFlagId], references: [id], onDelete: Cascade)

  @@unique([emailClassificationResponseId, emailRedFlagId])
  @@index([emailClassificationResponseId])
  @@index([emailRedFlagId])
}

model InteractionEvent {
  id                            String                       @id @default(uuid())
  learnerProfileId              String
  campaignAssignmentId          String?
  campaignItemId                String?
  eventType                     InteractionEventType
  targetType                    InteractionTargetType
  targetId                      String
  occurredAt                    DateTime                     @default(now())
  metadata                      Json?
  simulatedEmailId              String?
  trainingDocumentId            String?
  quizAttemptId                 String?
  quizId                        String?
  quizQuestionId                String?
  emailClassificationResponseId String?
  createdAt                     DateTime                     @default(now())
  learnerProfile                LearnerProfile               @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  campaignAssignment            CampaignAssignment?          @relation(fields: [campaignAssignmentId], references: [id], onDelete: SetNull)
  campaignItem                  CampaignItem?                @relation(fields: [campaignItemId], references: [id], onDelete: SetNull)
  simulatedEmail                SimulatedEmail?              @relation(fields: [simulatedEmailId], references: [id], onDelete: SetNull)
  trainingDocument              TrainingDocument?            @relation(fields: [trainingDocumentId], references: [id], onDelete: SetNull)
  quizAttempt                   QuizAttempt?                 @relation(fields: [quizAttemptId], references: [id], onDelete: SetNull)
  quiz                          Quiz?                        @relation(fields: [quizId], references: [id], onDelete: SetNull)
  quizQuestion                  QuizQuestion?                @relation(fields: [quizQuestionId], references: [id], onDelete: SetNull)
  emailClassificationResponse   EmailClassificationResponse? @relation(fields: [emailClassificationResponseId], references: [id], onDelete: SetNull)

  @@index([learnerProfileId])
  @@index([campaignAssignmentId])
  @@index([campaignItemId])
  @@index([eventType])
  @@index([targetType, targetId])
  @@index([simulatedEmailId])
  @@index([trainingDocumentId])
  @@index([quizAttemptId])
  @@index([quizId])
  @@index([quizQuestionId])
  @@index([emailClassificationResponseId])
  @@index([occurredAt])
}
