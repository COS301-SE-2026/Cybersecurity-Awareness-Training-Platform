COMPOSE_PROJECT_NAME=app
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
NODE_ENV=production
BACKEND_PORT=4000
FRONTEND_PORT=5173
AUTH_TOKEN_SECRET=
AUTH_COOKIE_SECURE=true
AUTH_TOKEN_EXPIRES_IN_SECONDS=
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX_REQUESTS=
TRUST_PROXY_HOPS=1
FRONTEND_ORIGIN=https://insightfulphish.co.za
VITE_API_BASE_URL=https://api.insightfulphish.co.za #used during build not runtime
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Insightful Phish
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_EMAIL_ADDRESS=

EMAIL_DISPATCHER_ENABLED=true
EMAIL_DISPATCHER_POLL_INTERVAL_MS=1000
EMAIL_DISPATCHER_BATCH_SIZE=10
EMAIL_DISPATCHER_LEASE_SECONDS=75
EMAIL_DISPATCHER_MAX_ATTEMPTS=4
EMAIL_DISPATCHER_BACKOFF_SECONDS=15,30,60
EMAIL_DISPATCHER_RETRY_DEADLINE_SECONDS=120
